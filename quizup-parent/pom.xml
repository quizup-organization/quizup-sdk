<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>io.github.quizup</groupId>
    <artifactId>quizup-parent</artifactId>
    <version>2.1.0</version>
    <packaging>pom</packaging>

    <name>quizup-parent</name>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/quizup-organization/quizup-sdk</url>
        </repository>
    </distributionManagement>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <quizup-sdk.version>2.1.0</quizup-sdk.version>

        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <spring-doc.version>2.8.17</spring-doc.version>

        <axon.version>4.13.1</axon.version>
        <axon-kafka-extension.version>4.12.1</axon-kafka-extension.version>
        <axon-springcloud-extension.version>4.12.1</axon-springcloud-extension.version>
        <db-scheduler.version>16.12.0</db-scheduler.version>

        <commons-text.version>1.15.0</commons-text.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-collections4.version>4.5.0</commons-collections4.version>

        <lombok.version>1.18.46</lombok.version>

        <postgresql.version>42.7.11</postgresql.version>

        <flyway.version>13.3.0</flyway.version>
        <rabbitmq.version>5.20.0</rabbitmq.version>
        <slf4j.version>2.0.18</slf4j.version>
        <amqp-client.version>5.30.0</amqp-client.version>

        <testcontainers.version>1.19.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.axonframework</groupId>
                <artifactId>axon-bom</artifactId>
                <version>${axon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Extension Axon Kafka -->
            <dependency>
                <groupId>org.axonframework.extensions.kafka</groupId>
                <artifactId>axon-kafka</artifactId>
                <version>${axon-kafka-extension.version}</version>
            </dependency>
            <dependency>
                <groupId>org.axonframework.extensions.kafka</groupId>
                <artifactId>axon-kafka-spring-boot-autoconfigure</artifactId>
                <version>${axon-kafka-extension.version}</version>
            </dependency>

            <!-- Extension Axon Spring Cloud -->
            <dependency>
                <groupId>org.axonframework.extensions.springcloud</groupId>
                <artifactId>axon-springcloud</artifactId>
                <version>${axon-springcloud-extension.version}</version>
            </dependency>
            <dependency>
                <groupId>org.axonframework.extensions.springcloud</groupId>
                <artifactId>axon-springcloud-spring-boot-autoconfigure</artifactId>
                <version>${axon-springcloud-extension.version}</version>
            </dependency>

            <!-- DB Scheduler (deadlines persistantes) -->
            <dependency>
                <groupId>com.github.kagkarlsson</groupId>
                <artifactId>db-scheduler-spring-boot-starter</artifactId>
                <version>${db-scheduler.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>${amqp-client.version}</version>
            </dependency>

            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${spring-doc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${spring-doc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>${commons-collections4.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${commons-text.version}</version>
            </dependency>


            <!-- Artefacts SDK QuizUp -->
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-microservice-core</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-microservice-autoconfigure</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-microservice-starter</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-axon-query</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-axon-deadline</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-axon-autoconfigure</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-axon-starter</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.quizup</groupId>
                <artifactId>quizup-axon-test</artifactId>
                <version>${quizup-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

